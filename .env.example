# 開発ではプロジェクト直下に .env を作成し、このファイルをベースにしてください。
# npm run server は dotenv で .env を自動読み込みします（Git にコミットしないこと）。

# --- フロント（Vite ビルド時に埋め込み）---
# GitHub Pages のような静的ホストでは、プロキシを別 URL で動かし絶対パスを指定する。
# 例: https://your-api.example.com/api/llm  （末尾スラッシュなし）
# ローカルでは通常不要（npm run server と npm run dev を並行し /api/llm をプロキシ）
# VITE_LLM_API_BASE=

# --- サーバー（server/proxy.mjs）— Google Gemini（generateContent / v1beta）---
# AI Studio: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# または GOOGLE_API_KEY=（どちらか一方で可）
# 既定モデル（クライアントが models に何も送らないとき）
# GEMINI_MODEL=gemini-2.5-flash
# エンドポイントを変える必要がある場合のみ（通常は不要）
# GEMINI_API_ROOT=https://generativelanguage.googleapis.com/v1beta
# PORT=8787
# CORS_ALLOW_ORIGIN=http://localhost:5173,https://your-org.github.io
# シナリオ生成の日次上限（既定 3）。日本時間でリセット。
# SCENARIO_QUOTA_PER_DAY=3
# フロントと API が別オリジンのときは SameSite=None; Secure が必要な場合があります。
# COOKIE_SAMESITE_NONE=1
# COOKIE_SECURE=1
